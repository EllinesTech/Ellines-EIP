# Ellines EIP — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# ── General ──────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Supabase ─────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only — never expose to the browser
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase pooler (eu-west-2 / aws-1) — IPv4
# Transaction pooler — app runtime
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler — migrations / Prisma db push
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=10

# ── API Gateway ──────────────────────────────────────
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0

# ── Identity Service ─────────────────────────────────
IDENTITY_SERVICE_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=24h

# ── Integration Hub ──────────────────────────────────
INTEGRATION_HUB_PORT=3002
SYNC_INTERVAL_MINUTES=15

# ── Ellinea AI ───────────────────────────────────────
ELLINEA_AI_PORT=3003
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ── Workflow Service ─────────────────────────────────
WORKFLOW_SERVICE_PORT=3004

# ── Notification Service ─────────────────────────────
NOTIFICATION_SERVICE_PORT=3005
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# ── Web App ──────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001
