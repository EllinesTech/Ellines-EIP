# Ellines EIP — Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# ── General ──────────────────────────────────────────
NODE_ENV=development
LOG_LEVEL=debug

# ── Supabase ─────────────────────────────────────────
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only — never expose to the browser
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase pooler (eu-west-2 / aws-1) — IPv4
# Transaction pooler — app runtime
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler — migrations / Prisma db push
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:[YOUR-PASSWORD]@aws-1-eu-west-2.pooler.supabase.com:5432/postgres
DATABASE_POOL_SIZE=10

# ── API Gateway ──────────────────────────────────────
API_GATEWAY_PORT=3000
API_GATEWAY_HOST=0.0.0.0

# ── Identity Service ─────────────────────────────────
IDENTITY_SERVICE_PORT=3001
JWT_SECRET=change-me-in-production-use-long-random-string
JWT_EXPIRES_IN=24h
# Comma-separated Ellines operator emails (Platform Super Admin — not org RBAC)
PLATFORM_ADMIN_EMAILS=you@ellines.co.ke

# ── Integration Hub ──────────────────────────────────
INTEGRATION_HUB_PORT=3002
SYNC_INTERVAL_MINUTES=15

# ── Ellinea AI ───────────────────────────────────────
ELLINEA_AI_PORT=3003
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=gpt-4o

# ── Workflow Service ─────────────────────────────────
WORKFLOW_SERVICE_PORT=3004

# ── Notification / outbound email ────────────────────
# Live path: Pages Function POST /api/v1/notifications/deliver
# Without secrets → outbox status `simulated` (CI-safe).
# Prefer Resend on Cloudflare Pages (HTTPS). SMTP_* works via Workers sockets
# when set on Pages; ELLINEA_SMTP_* are aliases. Nest worker port reserved.
NOTIFICATION_SERVICE_PORT=3005
# Resend (recommended for Pages edge)
RESEND_API_KEY=
# Alias accepted by the deliver Function
ELLINEA_SMTP_API_KEY=
# SMTP (optional; also ELLINEA_SMTP_HOST/PORT/USER/PASS/FROM/SECURE)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ellines EIP <noreply@ellines.co.ke>
SMTP_SECURE=false
ELLINEA_SMTP_HOST=
ELLINEA_SMTP_PORT=
ELLINEA_SMTP_USER=
ELLINEA_SMTP_PASS=
ELLINEA_SMTP_FROM=
ELLINEA_SMTP_SECURE=
# Web Push (optional; without keys → push stays `simulated`)
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@ellines.co.ke
ELLINEA_VAPID_PUBLIC_KEY=
ELLINEA_VAPID_PRIVATE_KEY=
ELLINEA_VAPID_SUBJECT=

# ── Web App ──────────────────────────────────────────
# Local: Nest Identity on :3001. Production Pages uses same-origin Functions
# (leave NEXT_PUBLIC_API_URL empty / unset in CI). Optional override → Fly URL.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── CORS (Identity) ──────────────────────────────────
CORS_ORIGINS=http://localhost:3100,https://eip.ellines.co.ke,https://ellines-eip.pages.dev

# ── Demo seed (npm run seed:demo) ────────────────────
DEMO_EMAIL=demo@ellines.co.ke
DEMO_PASSWORD=EllinesDemo2026!
DEMO_ORG_NAME=Ellines Demo Org
DEMO_ORG_SLUG=ellines-demo
DEMO_FULL_NAME=Demo Executive

# ── Observability (OpenTelemetry) ────────────────────
# Tracing (Jaeger / OpenTelemetry Collector)
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=ellines-eip-identity
OTEL_TRACES_EXPORTER=otlp
JAEGER_HOST=localhost
JAEGER_PORT=6831

# Metrics (Prometheus)
PROMETHEUS_PORT=9090
OTEL_METRICS_EXPORTER=otlp

# Logging (Elasticsearch / Loki)
ELASTICSEARCH_URL=http://localhost:9200
LOKI_URL=http://localhost:3100
