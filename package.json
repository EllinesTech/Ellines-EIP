{
  "name": "ellines-eip",
  "version": "0.1.0",
  "private": true,
  "description": "Ellines EIP (Enterprise Intelligence Platform) — Where Enterprise Systems Think Together",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "npm run build:shared",
    "dev": "node scripts/free-ports.mjs 3100 3001 && concurrently -n shared,sdk,identity,web -c gray,yellow,magenta,cyan \"npm run dev -w @ellines-eip/shared\" \"npm run dev -w @ellines-eip/connectors-sdk\" \"npm run dev -w @ellines-eip/identity\" \"npm run dev -w @ellines-eip/web\"",
    "dev:identity": "npm run dev -w @ellines-eip/identity",
    "dev:web": "npm run dev -w @ellines-eip/web",
    "build": "npm run build --workspaces --if-present",
    "build:shared": "npm run build -w @ellines-eip/shared && npm run build -w @ellines-eip/connectors-sdk && npm run build -w @ellines-eip/ellinea-ai && npm run build -w @ellines-eip/ellinea-sdk",
    "build:web": "npm run build:shared && npm run build -w @ellines-eip/web",
    "verify:pages-functions": "node scripts/verify-pages-functions.mjs",
    "verify:data-layer": "node scripts/verify-data-layer.mjs",
    "set-pages-secrets": "node scripts/set-pages-secrets.mjs",
    "deploy:pages": "npm run verify:pages-functions && npm run build:web && npm run deploy:pages -w @ellines-eip/web",
    "db:push": "npm run prisma:push -w @ellines-eip/identity",
    "db:migrate:dev": "npm run prisma:migrate:dev -w @ellines-eip/identity",
    "db:migrate:deploy": "npm run prisma:migrate:deploy -w @ellines-eip/identity",
    "db:migrate:status": "npm run prisma:migrate:status -w @ellines-eip/identity",
    "db:generate": "npm run prisma:generate -w @ellines-eip/identity",
    "db:studio": "npm run prisma:studio -w @ellines-eip/identity",
    "db:local": "node scripts/db-switch.mjs local",
    "db:cloud": "node scripts/db-switch.mjs cloud",
    "db:status": "node scripts/db-switch.mjs status",
    "seed:demo": "npm run seed:demo -w @ellines-eip/identity",
    "seed:rate-limits": "npm run seed:rate-limits -w @ellines-eip/identity",
    "seed:local": "npm run db:local && npm run seed:demo && npm run seed:rate-limits && npm run db:cloud",
    "seed:cloud": "npm run db:cloud && npm run seed:demo && npm run seed:rate-limits",
    "seed:both": "node scripts/seed-both.mjs",
    "db:sync:to-cloud": "node scripts/db-sync.mjs to-cloud --include-demo",
    "db:sync:from-cloud": "node scripts/db-sync.mjs from-cloud --include-demo",
    "db:sync:status": "node scripts/db-sync.mjs status",
    "db:sync:platform": "node scripts/db-sync.mjs to-cloud",
    "db:sync:full": "node scripts/db-sync.mjs to-cloud --include-demo --include-user-data",
    "deploy:identity": "flyctl deploy --config services/identity/fly.toml --dockerfile services/identity/Dockerfile --app ellines-eip-identity",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "security:audit": "node scripts/security-audit.mjs",
    "perf:benchmark": "node scripts/perf-benchmark.mjs --bundle-only",
    "perf:benchmark:api": "node scripts/perf-benchmark.mjs",
    "perf:bundle": "node scripts/bundle-size-check.mjs",
    "perf:bundle:baseline": "node scripts/bundle-size-check.mjs --save-baseline",
    "lint": "npm run lint --workspaces --if-present",
    "docker:up": "docker compose -f infra/docker/docker-compose.yml up -d",
    "docker:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "autocannon": "^7.15.0",
    "concurrently": "^9.2.4"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@openrouter/agent": "^0.11.0",
    "@openrouter/sdk": "^1.3.10"
  }
}
