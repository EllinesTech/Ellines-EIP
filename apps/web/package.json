{
  "name": "@ellines-eip/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run -w @ellines-eip/web predev:shims && cross-env NODE_ENV=development NEXT_DIST_DIR=.next-dev next dev -p 3100",
    "predev:shims": "node ../../scripts/generate-pages-shims.mjs",
    "prebuild": "node ../../scripts/generate-pages-shims.mjs --clean",
    "build": "cross-env NODE_ENV=production NEXT_DIST_DIR=.next EIP_STATIC_EXPORT=1 next build",
    "start": "next start -p 3100",
    "lint": "next lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "deploy:pages": "npm run build && npx wrangler pages deploy out --project-name=ellines-eip --commit-dirty=true --branch=main"
  },
  "dependencies": {
    "@ellines-eip/ellinea-ai": "*",
    "@ellines-eip/shared": "*",
    "@supabase/supabase-js": "^2.111.0",
    "bcryptjs": "^3.0.3",
    "itty-router": "^5.0.24",
    "jose": "^6.2.5",
    "nanoid": "^6.0.1",
    "next": "^15.5.23",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-grid-layout": "1.5.4",
    "react-is": "^19.0.0",
    "recharts": "^3.10.1",
    "socket.io-client": "4.8.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@next/bundle-analyzer": "^15.5.23",
    "@testing-library/react": "^16.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.13",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/react-grid-layout": "1.3.6",
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5.8.2"
  }
}
