# Generated local-dev API bridges (see scripts/generate-pages-shims.mjs). They
# invoke the real Cloudflare Pages Function so `next dev` serves the same API
# production does, and are regenerated on every `npm run dev`. Never committed.
# NOTE: this must not ignore the whole src/pages/api directory — it also holds
# hand-written dev routes that ARE tracked.
