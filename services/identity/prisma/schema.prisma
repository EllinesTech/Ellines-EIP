generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  owner
  admin
  executive
  manager
  member
  viewer
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /** Optional parent org for multi-company groups (v1.1). Null = top-level org. */
  parentOrgId String? @map("parent_org_id")
  /** Display prefs e.g. { timeFormat, dateStyle } — org/platform admin editable. */
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                  User[]
  branches               Branch[]
  departments            Department[]
  auditLogs              AuditLog[]
  passwordResetTokens    PasswordResetToken[]
  enterpriseSnapshot     EnterpriseSnapshot?
  connectorInstallations ConnectorInstallation[]
  approvalRequests       ApprovalRequest[]
  businessRules          BusinessRule[]
  scheduledReports       ScheduledReport[]
  enterpriseEvents       EnterpriseEvent[]
  memberships            OrganizationMembership[]
  childOrgs              Organization[]           @relation("OrgParent")
  parentOrg              Organization?            @relation("OrgParent", fields: [parentOrgId], references: [id], onDelete: SetNull)

  @@index([parentOrgId])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  code           String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]

  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  branchId       String?  @map("branch_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  fullName       String   @map("full_name")
  /** Optional job title shown on profile (e.g. Chief Executive). */
  title          String?
  /** Short personal bio / about. */
  bio            String?  @db.Text
  /** Profile photo as compressed data URL (or external URL later). */
  avatarUrl      String?  @map("avatar_url") @db.Text
  organizationId String   @map("organization_id")
  role           UserRole @default(member)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  memberships         OrganizationMembership[]

  @@index([organizationId])
  @@map("users")
}

/**
 * v1.1 — Multi-company membership.
 * A User can belong to multiple Organizations with different roles.
 * The primary org remains User.organizationId (backward compat).
 */
model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           UserRole @default(member)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@map("organization_memberships")
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  organizationId String?   @map("organization_id")
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  resource       String?
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model EnterpriseSnapshot {
  id               String   @id @default(cuid())
  organizationId   String   @unique @map("organization_id")
  connectorId      String   @map("connector_id")
  connectorName    String   @map("connector_name")
  healthScore      Int      @map("health_score")
  connectedSystems Int      @map("connected_systems")
  openAlerts       Int      @map("open_alerts")
  openDecisions    Int      @map("open_decisions")
  briefHighlight   String   @map("brief_highlight")
  timeline         Json
  syncedAt         DateTime @map("synced_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("enterprise_snapshots")
}

/** Per-org connector wizard install — config persists server-side (not localStorage). */
model ConnectorInstallation {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  catalogId      String    @map("catalog_id")
  displayName    String    @map("display_name")
  config         Json
  status         String    @default("draft")
  lastTestAt     DateTime? @map("last_test_at")
  lastSyncedAt   DateTime? @map("last_synced_at")
  lastMessage    String?   @map("last_message")
  packId         String?   @map("pack_id")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pack         ConnectorPack? @relation(fields: [packId], references: [id], onDelete: SetNull)

  @@unique([organizationId, packId])
  @@index([organizationId])
  @@map("connector_installations")
}

/** Platform Super Admin publishes packs; Org IT installs with credentials only. */
model ConnectorPack {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String   @default("")
  catalogId        String   @map("catalog_id")
  templateConfig   Json     @map("template_config")
  published        Boolean  @default(true)
  createdByEmail   String?  @map("created_by_email")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  installations ConnectorInstallation[]

  @@map("connector_packs")
}

// ─── Phase 5 — Workflow & Automation ────────────────────────────────────────

/** Multi-step approval request (Phase 5.1). */
model ApprovalRequest {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  title             String
  detail            String    @default("")
  requester         String
  status            String    @default("pending")   // pending | approved | rejected
  templateId        String    @default("simple") @map("template_id")
  currentStepIndex  Int       @default(0) @map("current_step_index")
  source            String    @default("manual")    // manual | template | decision-seed
  decidedAt         DateTime? @map("decided_at")
  decidedBy         String?   @map("decided_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        ApprovalStep[]

  @@index([organizationId])
  @@index([status])
  @@map("approval_requests")
}

/** Individual step within an ApprovalRequest (Phase 5.1). */
model ApprovalStep {
  id                String    @id @default(cuid())
  approvalRequestId String    @map("approval_request_id")
  stepOrder         Int       @map("step_order")
  key               String
  label             String
  status            String    @default("pending")   // pending | approved | rejected
  actorRole         String    @map("actor_role")
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime? @map("decided_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
  @@map("approval_steps")
}

/** If/then business rule on enterprise snapshot metrics (Phase 5.2). */
model BusinessRule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  enabled        Boolean  @default(true)
  when           String                           // open_alerts_gte | open_decisions_gte | health_lt
  threshold      Int
  then           String                           // seed_approval | flag_overview
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("business_rules")
}

/** Scheduled report definition (Phase 5.3). */
model ScheduledReport {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  title          String
  cadence        String    @default("daily")      // daily | weekly
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("scheduled_reports")
}

/** Enterprise event bus log (Phase 5.4). */
model EnterpriseEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  type           String
  payload        Json     @default("{}")
  at             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([at])
  @@map("enterprise_events")
}
