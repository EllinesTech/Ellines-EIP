generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  owner
  admin
  executive
  manager
  member
  viewer
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  /** Optional parent org for multi-company groups (v1.1). Null = top-level org. */
  parentOrgId String? @map("parent_org_id")
  /** Display prefs e.g. { timeFormat, dateStyle } — org/platform admin editable. */
  settings  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users                  User[]
  branches               Branch[]
  departments            Department[]
  auditLogs              AuditLog[]
  passwordResetTokens    PasswordResetToken[]
  enterpriseSnapshot     EnterpriseSnapshot?
  connectorInstallations ConnectorInstallation[]
  approvalRequests       ApprovalRequest[]
  businessRules          BusinessRule[]
  scheduledReports       ScheduledReport[]
  enterpriseEvents       EnterpriseEvent[]
  memberships            OrganizationMembership[]
  childOrgs              Organization[]           @relation("OrgParent")
  parentOrg              Organization?            @relation("OrgParent", fields: [parentOrgId], references: [id], onDelete: SetNull)
  ssoProviders           SsoProvider[]
  customRoles            CustomRole[]
  roleAuditLogs          RoleAuditLog[]
  dashboards             Dashboard[]             // Track B: BI Dashboards
  workflowRules          WorkflowRule[]          // Track C: Autonomous Workflows
  ellineaAgents          EllineaAgent[]          // v2.0 A.1: Autonomous Agents
  agentSubscriptions     AgentWebhookSubscription[] @relation("AgentSubscriptions")
  databaseConfigs        DatabaseConfiguration[]   // Multi-database support
  databaseSwitchLogs     DatabaseSwitchLog[]     // Database switch audit trail
  apiUsage               ApiUsage[]              // B.3.2: API usage tracking
  organizationTier       OrganizationTier?       // B.3.2: Rate limit tier
  rateLimitViolations    RateLimitViolation[]    // B.3.2: Rate limit violations

  @@index([parentOrgId])
  @@map("organizations")
}

model Branch {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  code           String?
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  departments  Department[]

  @@index([organizationId])
  @@map("branches")
}

model Department {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  branchId       String?  @map("branch_id")
  name           String
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@map("departments")
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String   @map("password_hash")
  fullName       String   @map("full_name")
  /** Optional job title shown on profile (e.g. Chief Executive). */
  title          String?
  /** Short personal bio / about. */
  bio            String?  @db.Text
  /** Profile photo as compressed data URL (or external URL later). */
  avatarUrl      String?  @map("avatar_url") @db.Text
  organizationId String   @map("organization_id")
  role           UserRole @default(member)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  auditLogs           AuditLog[]
  passwordResetTokens PasswordResetToken[]
  memberships         OrganizationMembership[]
  ssoProviderUsers    SsoProviderUser[]
  apiUsage            ApiUsage[]              // B.3.2: API usage tracking
  rateLimitViolations RateLimitViolation[]    // B.3.2: Rate limit violations

  @@index([organizationId])
  @@map("users")
}

/**
 * v1.1 — Multi-company membership.
 * A User can belong to multiple Organizations with different roles.
 * The primary org remains User.organizationId (backward compat).
 * 
 * v1.1 Track D — Custom roles.
 * If customRoleId is set, it overrides the fixed `role` field.
 */
model OrganizationMembership {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  organizationId String   @map("organization_id")
  role           UserRole @default(member)       // Fallback if customRoleId not set
  customRoleId   String?  @map("custom_role_id") // If set, use this custom role instead
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customRole   CustomRole?  @relation(fields: [customRoleId], references: [id], onDelete: SetNull)

  @@unique([userId, organizationId])
  @@index([userId])
  @@index([organizationId])
  @@index([customRoleId])
  @@map("organization_memberships")
}

model PasswordResetToken {
  id             String    @id @default(cuid())
  userId         String    @map("user_id")
  organizationId String?   @map("organization_id")
  tokenHash      String    @unique @map("token_hash")
  expiresAt      DateTime  @map("expires_at")
  usedAt         DateTime? @map("used_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?  @map("organization_id")
  userId         String?  @map("user_id")
  action         String
  resource       String?
  metadata       Json?
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

model EnterpriseSnapshot {
  id               String   @id @default(cuid())
  organizationId   String   @unique @map("organization_id")
  connectorId      String   @map("connector_id")
  connectorName    String   @map("connector_name")
  healthScore      Int      @map("health_score")
  connectedSystems Int      @map("connected_systems")
  openAlerts       Int      @map("open_alerts")
  openDecisions    Int      @map("open_decisions")
  briefHighlight   String   @map("brief_highlight")
  timeline         Json
  syncedAt         DateTime @map("synced_at")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("enterprise_snapshots")
}

/** Per-org connector wizard install — config persists server-side (not localStorage). */
model ConnectorInstallation {
  id                  String    @id @default(cuid())
  organizationId      String    @map("organization_id")
  catalogId           String    @map("catalog_id")
  displayName         String    @map("display_name")
  config              Json
  status              String    @default("draft")
  lastTestAt          DateTime? @map("last_test_at")
  lastSyncedAt        DateTime? @map("last_synced_at")
  lastMessage         String?   @map("last_message")
  packId              String?   @map("pack_id")
  templateId          String?   @map("template_id")      // Track A: reference to ConnectorTemplate
  templateConfig      Json?     @map("template_config")  // Track A: user config merged with template defaults
  oauthRefreshToken   String?   @map("oauth_refresh_token") // Track A: OAuth token storage
  lastError           String?   @map("last_error")       // Track A: last sync error message
  errorCount          Int       @default(0) @map("error_count") // Track A: consecutive error count
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  pack         ConnectorPack?        @relation(fields: [packId], references: [id], onDelete: SetNull)
  template     ConnectorTemplate?    @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@unique([organizationId, packId])
  @@index([organizationId])
  @@index([templateId])
  @@map("connector_installations")
}

/** Platform Super Admin publishes packs; Org IT installs with credentials only. */
model ConnectorPack {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String   @default("")
  catalogId        String   @map("catalog_id")
  templateConfig   Json     @map("template_config")
  published        Boolean  @default(true)
  createdByEmail   String?  @map("created_by_email")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  installations ConnectorInstallation[]

  @@map("connector_packs")
}

// ─── Track A — Enterprise Connectors Framework ─────────────────────────────────

/**
 * ConnectorTemplate — Pre-built system-specific connector templates.
 * Platform Super Admin publishes templates; Org IT uses them to install connectors.
 * Templates define configuration schema, normalization rules, OAuth requirements, etc.
 */
model ConnectorTemplate {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  category            String                     // "ERP" | "CRM" | "HIS" | "HR" | "Database" | "REST" | "Email" | "File"
  description         String   @default("")
  configSchema        Json     @default("{}")    // JSON Schema for UI form generation
  normalizationRules  Json     @default("[]")    // Array of UEM normalization rules
  oauthRequired       Boolean  @default(false) @map("oauth_required")
  oauthScopes         Json?    @map("oauth_scopes")     // Optional: required OAuth scopes
  apiDocsUrl          String?  @map("api_docs_url")
  examples            Json?    @default("[]")   // Array of example configs
  published           Boolean  @default(true)
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @updatedAt @map("updated_at")

  installations ConnectorInstallation[]

  @@index([category])
  @@index([published])
  @@map("connector_templates")
}

// ─── Track B — BI Dashboards (Custom KPI Builder) ──────────────────────────────

/**
 * Dashboard — Custom KPI dashboard with drag-drop widgets.
 * Org IT / Owner creates dashboards; supports layout, refresh rate, and permissions.
 */
model Dashboard {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  name            String
  description     String   @default("")
  layout          Json     @default("[]")    // Array of { id, x, y, w, h, ... }
  refreshRate     Int      @default(300)    @map("refresh_rate")  // Seconds between refreshes
  isPublic        Boolean  @default(false) @map("is_public")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widgets      Widget[]
  exports      DashboardExport[]

  @@index([organizationId])
  @@map("dashboards")
}

/**
 * Widget — Individual widget (gauge, line, bar, table, KPI) on a dashboard.
 */
model Widget {
  id              String   @id @default(cuid())
  dashboardId     String   @map("dashboard_id")
  type            String                  // "gauge" | "line" | "bar" | "table" | "kpi"
  title           String
  config          Json     @default("{}")    // Widget-specific config
  position        Int                    // Grid position / order
  size            Json     @default("{\"w\":2,\"h\":2}") // Width and height in grid units
  dataSourceId    String?  @map("data_source_id") // Optional reference to data source
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  alerts    Alert[]

  @@index([dashboardId])
  @@map("widgets")
}

/**
 * Alert — Alert threshold on a widget (e.g., if KPI > 100, trigger action).
 */
model Alert {
  id              String   @id @default(cuid())
  widgetId        String   @map("widget_id")
  condition       String                  // "gt" | "lt" | "eq" | "gte" | "lte"
  threshold       Float
  actions         Json     @default("[]")    // Array of { type: "email" | "webhook" | "notification", recipient: "..." }
  active          Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  widget Widget @relation(fields: [widgetId], references: [id], onDelete: Cascade)

  @@index([widgetId])
  @@map("alerts")
}

/**
 * DashboardExport — Scheduled dashboard exports (PDF, CSV).
 */
model DashboardExport {
  id              String    @id @default(cuid())
  dashboardId     String    @map("dashboard_id")
  format          String                 // "pdf" | "csv" | "excel"
  schedule        String?              // Cron expression for email scheduling (null = manual only)
  lastRun         DateTime? @map("last_run")
  nextRun         DateTime? @map("next_run")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@index([dashboardId])
  @@map("dashboard_exports")
}

// ─── Track C — Autonomous Workflows (AI Agent Rules) ─────────────────────────────

/**
 * WorkflowRule — Autonomous rule with trigger, condition, action, and autonomy level.
 * Autonomy levels: 1 = Deterministic, 2 = AI-assisted (requires approval), 3 = Scheduled (auto-execute).
 */
model WorkflowRule {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  name            String
  description     String   @default("")
  autonomyLevel   Int      @default(1) @map("autonomy_level") // 1 | 2 | 3
  trigger         String                  // Event type: "approval_created" | "alert_threshold" | "schedule" | "manual"
  condition       Json     @default("{}")    // Condition logic (e.g., { "field": "status", "op": "eq", "value": "pending" })
  action          Json     @default("{}")    // Action to execute (e.g., { "type": "approve", "escalate": true })
  isActive        Boolean  @default(true) @map("is_active")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   RuleExecution[]
  schedules    RuleSchedule[]

  @@index([organizationId])
  @@index([autonomyLevel])
  @@map("workflow_rules")
}

/**
 * RuleExecution — Log of rule execution with status, recommendations, and approval state.
 */
model RuleExecution {
  id                  String    @id @default(cuid())
  ruleId              String    @map("rule_id")
  triggeredAt         DateTime  @map("triggered_at")
  status              String                  // "pending" | "approved" | "rejected" | "executed" | "failed"
  aiRecommendation    Json?     @map("ai_recommendation") // AI reasoning and confidence
  humanApprovalBy     String?   @map("human_approval_by")
  humanApprovalAt     DateTime? @map("human_approval_at")
  executedAt          DateTime? @map("executed_at")
  executionError      String?   @map("execution_error")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  rule WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([ruleId])
  @@index([status])
  @@index([triggeredAt])
  @@map("rule_executions")
}

/**
 * RuleSchedule — Cron schedule for Level 3 (autonomous) rules.
 */
model RuleSchedule {
  id              String   @id @default(cuid())
  ruleId          String   @map("rule_id")
  cronExpression  String   @map("cron_expression")
  timezone        String   @default("UTC")
  lastRun         DateTime? @map("last_run")
  nextRun         DateTime? @map("next_run")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  rule WorkflowRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId])
  @@index([ruleId])
  @@map("rule_schedules")
}

/**
 * RuleTemplate — Pre-built rule template (e.g., "Escalate pending approvals after 3 days").
 */
model RuleTemplate {
  id              String   @id @default(cuid())
  name            String
  description     String   @default("")
  rules           Json     @default("[]")    // Array of rule definitions
  category        String   @default("general") // "approval" | "alert" | "sync" | "general"
  published       Boolean  @default(true)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("rule_templates")
}

// ─── Phase 5 — Workflow & Automation ────────────────────────────────────────

/** Multi-step approval request (Phase 5.1). */
model ApprovalRequest {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  title             String
  detail            String    @default("")
  requester         String
  status            String    @default("pending")   // pending | approved | rejected
  templateId        String    @default("simple") @map("template_id")
  currentStepIndex  Int       @default(0) @map("current_step_index")
  source            String    @default("manual")    // manual | template | decision-seed
  decidedAt         DateTime? @map("decided_at")
  decidedBy         String?   @map("decided_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  steps        ApprovalStep[]

  @@index([organizationId])
  @@index([status])
  @@map("approval_requests")
}

/** Individual step within an ApprovalRequest (Phase 5.1). */
model ApprovalStep {
  id                String    @id @default(cuid())
  approvalRequestId String    @map("approval_request_id")
  stepOrder         Int       @map("step_order")
  key               String
  label             String
  status            String    @default("pending")   // pending | approved | rejected
  actorRole         String    @map("actor_role")
  decidedBy         String?   @map("decided_by")
  decidedAt         DateTime? @map("decided_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)

  @@index([approvalRequestId])
  @@map("approval_steps")
}

/** If/then business rule on enterprise snapshot metrics (Phase 5.2). */
model BusinessRule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  enabled        Boolean  @default(true)
  when           String                           // open_alerts_gte | open_decisions_gte | health_lt
  threshold      Int
  then           String                           // seed_approval | flag_overview
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("business_rules")
}

/** Scheduled report definition (Phase 5.3). */
model ScheduledReport {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  title          String
  cadence        String    @default("daily")      // daily | weekly
  enabled        Boolean   @default(true)
  lastRunAt      DateTime? @map("last_run_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@map("scheduled_reports")
}

/** Enterprise event bus log (Phase 5.4). */
model EnterpriseEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  type           String
  payload        Json     @default("{}")
  at             DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([at])
  @@map("enterprise_events")
}

// v1.1: OAuth2 / SAML SSO
model SsoProvider {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  
  // Provider Type
  type           String   // 'oauth2' | 'saml2' | 'openid'
  name           String   // Display name: "Azure AD", "Okta", "Google"
  
  // OAuth2 / OIDC Config
  clientId       String?  @map("client_id")
  clientSecret   String?  @map("client_secret")  // Encrypted in production
  discoveryUrl   String?  @map("discovery_url")  // OIDC Discovery endpoint
  authzUrl       String?  @map("authz_url")      // OAuth2 authorization endpoint
  tokenUrl       String?  @map("token_url")      // Token endpoint
  userinfoUrl    String?  @map("userinfo_url")   // UserInfo endpoint
  
  // SAML2 Config
  entityId       String?  @map("entity_id")      // EIP's SAML entity ID
  idpEntityId    String?  @map("idp_entity_id")  // IdP entity ID
  idpSsoUrl      String?  @map("idp_sso_url")    // Single Sign-On Service URL
  idpSloUrl      String?  @map("idp_slo_url")    // Single Logout Service URL
  idpCertificate String?  @map("idp_certificate") @db.Text  // Base64-encoded cert
  acsUrl         String?  @map("acs_url")        // Assertion Consumer Service URL
  
  // Attribute Mapping (JSON)
  attributeMap   Json?    @map("attribute_map")  // { "email": "...", "name": "..." }
  
  // Auto-provisioning
  autoProvision  Boolean  @default(true) @map("auto_provision")
  defaultRole    String   @default("member") @map("default_role")
  
  // Group → Role Mapping
  groupRoleMap   Json?    @map("group_role_map")  // { "admin-group": "admin" }
  
  // Settings
  isActive       Boolean  @default(true) @map("is_active")
  enforced       Boolean  @default(false)  // Disable email/password login?
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users          SsoProviderUser[]

  @@unique([organizationId, type])
  @@index([organizationId])
  @@index([isActive])
  @@map("sso_providers")
}

model SsoProviderUser {
  id             String   @id @default(cuid())
  ssoProviderId  String   @map("sso_provider_id")
  userId         String   @map("user_id")
  
  // External identifier (IdP user ID)
  externalId     String   @map("external_id")  // SAML NameID or OIDC sub
  externalEmail  String   @map("external_email")
  
  // Attributes from IdP
  attributes     Json?    // Last sync of user attributes
  
  // Linking state
  linkedAt       DateTime @default(now()) @map("linked_at")
  lastLoginAt    DateTime? @map("last_login_at")

  ssoProvider    SsoProvider @relation(fields: [ssoProviderId], references: [id], onDelete: Cascade)
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ssoProviderId, externalId])
  @@index([ssoProviderId])
  @@index([userId])
  @@map("sso_provider_users")
}

// v1.1 Track D — Advanced RBAC (Custom Roles)

/**
 * Custom Role — allows Owner to create roles beyond the 6 fixed roles.
 * 
 * Permissions are stored as JSON array of resource permissions.
 * Example:
 * {
 *   "permissions": [
 *     { "permission": "connector:read" },
 *     { "permission": "connector:install", "attributes": { "department": "IT" } },
 *     { "permission": "approval:decide", "resources": ["approval-1", "approval-2"] }
 *   ]
 * }
 */
model CustomRole {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String                           // "Finance Manager", "Analyst", etc.
  description    String   @default("")
  color          String   @default("#6F2D8D")     // UI badge color
  
  // Base role this is derived from (optional; helps with UI hints)
  baseRole       String?  @map("base_role")       // null | 'owner' | 'admin' | 'manager' | 'member' | 'viewer'
  
  // Permissions array: [ { permission: string, resources?: string[], attributes?: {}, conditions?: {} } ]
  permissions    Json     @default("[]")
  
  // Metadata
  isSystem       Boolean  @default(false) @map("is_system")  // System roles cannot be modified
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      String   @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  memberships    OrganizationMembership[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isActive])
  @@map("custom_roles")
}

/**
 * Role Audit Log — tracks all role changes (creation, modification, assignment, deletion).
 * Enables compliance tracking and role history.
 */
model RoleAuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  roleId         String?  @map("role_id")         // Role that was changed (null if deleted)
  userId         String   @map("user_id")         // User who made the change
  action         String                           // 'role.created' | 'role.updated' | 'role.assigned' | 'role.deleted'
  details        Json?                            // Previous role data, permissions diff, etc.
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([roleId])
  @@index([userId])
  @@index([createdAt])
  @@map("role_audit_logs")
}

// ─── v2.0 Phase A — Autonomous AI & Advanced Workflows (Ellinea Agents) ─────────

/**
 * EllineaAgent — Autonomous AI agent that acts on enterprise events.
 * Agents can auto-approve, auto-reorder, escalate, or execute custom actions.
 * Three confidence levels: low (queue for approval), medium (notify + act), high (auto-execute).
 */
model EllineaAgent {
  id              String   @id @default(cuid())
  organizationId  String   @map("organization_id")
  name            String
  description     String   @default("")
  templateId      String?  @map("template_id")    // Optional reference to AgentTemplate
  
  // Trigger configuration
  trigger         String                          // Event type: "approval_pending" | "alert_threshold" | "sync_complete" | "manual"
  triggerConfig   Json     @default("{}")         // Trigger-specific config (e.g., { "alertType": "critical", "thresholdValue": 5 })
  
  // Condition logic (when to act)
  condition       Json     @default("{}")         // Condition rules (e.g., { "field": "amount", "op": "gt", "value": 1000 })
  
  // Action configuration
  action          Json     @default("{}")         // Action to execute (e.g., { "type": "auto_approve", "escalate": true, "notifyOwner": true })
  
  // Confidence & autonomy
  confidenceThreshold Float @default(0.7) @map("confidence_threshold") // 0.0-1.0: minimum confidence to auto-execute
  requireApproval Boolean  @default(false) @map("require_approval")   // If true, always queue for human approval regardless of confidence
  
  // Status
  isActive        Boolean  @default(true) @map("is_active")
  isPaused        Boolean  @default(false) @map("is_paused")
  
  // Stats
  executionCount  Int      @default(0) @map("execution_count")
  successCount    Int      @default(0) @map("success_count")
  lastExecutedAt  DateTime? @map("last_executed_at")
  
  // Metadata
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executions   AgentExecution[]
  auditLogs    AgentAuditLog[]
  subscriptions AgentWebhookSubscription[] @relation("AgentSubscriptions")

  @@index([organizationId])
  @@index([trigger])
  @@index([isActive])
  @@map("ellinea_agents")
}

/**
 * AgentExecution — Log of agent execution with AI reasoning, confidence, and approval state.
 */
model AgentExecution {
  id                  String    @id @default(cuid())
  agentId             String    @map("agent_id")
  organizationId      String    @map("organization_id")
  
  // Execution context
  triggeredBy         String    @map("triggered_by")    // Event type or "manual"
  triggerPayload      Json?     @map("trigger_payload") // Event payload snapshot
  
  // AI reasoning
  confidence          Float                             // 0.0-1.0: AI confidence score
  reasoning           Json?                             // AI explanation { "summary": "...", "evidence": [...], "risk": "low|medium|high" }
  recommendedAction   String?   @map("recommended_action") // What the agent recommends
  
  // Execution status
  status              String                            // "pending" | "approved" | "rejected" | "executed" | "failed" | "skipped"
  requiresApproval    Boolean   @default(false) @map("requires_approval")
  
  // Human oversight
  humanApprovalBy     String?   @map("human_approval_by")
  humanApprovalAt     DateTime? @map("human_approval_at")
  humanNote           String?   @map("human_note")
  
  // Execution result
  executedAt          DateTime? @map("executed_at")
  executionResult     Json?     @map("execution_result") // Result data from action
  executionError      String?   @map("execution_error")
  
  // Rollback support
  canRollback         Boolean   @default(false) @map("can_rollback")
  rolledBackAt        DateTime? @map("rolled_back_at")
  rolledBackBy        String?   @map("rolled_back_by")
  
  // User feedback (v2.0 A.2 — learning)
  feedbackScore       Int?      @map("feedback_score")    // -1 (unhelpful), 0 (neutral), +1 (helpful)
  feedbackComment     String?   @map("feedback_comment")
  feedbackAt          DateTime? @map("feedback_at")
  feedbackBy          String?   @map("feedback_by")
  
  // Timestamps
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")

  agent EllineaAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([organizationId])
  @@index([status])
  @@index([triggeredBy])
  @@index([createdAt])
  @@map("agent_executions")
}

/**
 * AgentAuditLog — Comprehensive audit trail for all agent actions.
 * Tracks creation, modification, execution, approval, and rollback.
 */
model AgentAuditLog {
  id             String   @id @default(cuid())
  agentId        String   @map("agent_id")
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")         // User who triggered the action (null for system)
  action         String                           // 'agent.created' | 'agent.updated' | 'agent.executed' | 'agent.approved' | 'agent.rolled_back'
  details        Json?                            // Action-specific details
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")

  agent EllineaAgent @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([organizationId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("agent_audit_logs")
}

/**
 * AgentTemplate — Pre-built agent templates (auto-approve <$500, escalate stuck approvals, etc.).
 * Platform admins publish templates; org admins install with 1-click.
 */
model AgentTemplate {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  description     String   @default("")
  category        String   @default("general")    // "approval" | "alert" | "sync" | "workflow" | "general"
  
  // Template configuration
  trigger         String
  triggerConfig   Json     @default("{}")
  condition       Json     @default("{}")
  action          Json     @default("{}")
  
  // Default settings
  confidenceThreshold Float @default(0.7) @map("confidence_threshold")
  requireApproval Boolean  @default(false) @map("require_approval")
  
  // Publishing
  published       Boolean  @default(true)
  featured        Boolean  @default(false)       // Featured templates shown first in gallery
  
  // Usage stats
  installCount    Int      @default(0) @map("install_count")
  
  // Metadata
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@index([published])
  @@index([featured])
  @@map("agent_templates")
}

/**
 * AgentWebhookSubscription — Subscribe agents to external event sources (connectors, webhooks, etc.)
 * Allows agents to be triggered by connector sync events, external webhooks, or system events.
 */
model AgentWebhookSubscription {
  id              String   @id @default(cuid())
  agentId         String   @map("agent_id")
  organizationId  String   @map("organization_id")
  
  // Event source
  eventSource     String   @map("event_source")   // "connector" | "webhook" | "system" | "manual"
  eventSourceId   String?  @map("event_source_id") // Connector ID, webhook ID, or null for system
  eventType       String   @map("event_type")     // Event type to subscribe to (e.g., "sync_complete", "sync_failed", "alert_raised")
  
  // Filter (optional)
  filter          Json?    @default("{}")         // Additional filter rules (e.g., { "connectorType": "sql_server" })
  
  // Status
  isActive        Boolean  @default(true) @map("is_active")
  
  // Metadata
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  agent EllineaAgent @relation("AgentSubscriptions", fields: [agentId], references: [id], onDelete: Cascade)
  organization Organization @relation("AgentSubscriptions", fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([agentId, eventSource, eventSourceId, eventType])
  @@index([organizationId])
  @@index([eventSource])
  @@index([eventType])
  @@index([isActive])
  @@map("agent_webhook_subscriptions")
}



// ─── Database Configuration (Multi-database Support) ─────────────────────────

/**
 * DatabaseConfiguration — Organizations can configure multiple databases (local + cloud).
 * Admin can switch primary database without code changes.
 * Supports: Local PostgreSQL, Supabase, Custom PostgreSQL servers.
 * 
 * Usage:
 * - Client chooses: local database (on-premise) OR supabase (cloud) OR custom server
 * - Admin can test connection before switching
 * - Switch marked as "primary" to use for all operations
 * - Optional backup sync (local ↔ cloud)
 */
model DatabaseConfiguration {
  id                String    @id @default(cuid())
  organizationId    String    @map("organization_id")
  
  // Basic info
  name              String                     // "Local Ubuntu", "Supabase Production", "Custom PG Server"
  type              String                     // 'local' | 'supabase' | 'custom_postgres'
  description       String    @default("")    @map("description")
  
  // Connection details (encrypted in production)
  host              String?                    // localhost | supabase-id.supabase.co | remote-server.com
  port              Int       @default(5432)
  username          String?                    @map("username")
  passwordEncrypted String?   @map("password_encrypted")  // Encrypted with org encryption key
  databaseName      String?   @map("database_name")
  
  // Supabase specific
  supabaseUrl       String?   @map("supabase_url")        // https://xxx.supabase.co
  supabaseKeyEncrypted String? @map("supabase_key_encrypted")  // Encrypted API key
  
  // Custom PostgreSQL additional options
  sslMode           String    @default("require") @map("ssl_mode")  // prefer | require | disable
  connectionTimeout Int       @default(30) @map("connection_timeout")  // Seconds
  
  // Status
  isPrimary         Boolean   @default(false) @map("is_primary")       // Primary database for all operations
  isActive          Boolean   @default(true) @map("is_active")
  testStatus        String    @default("untested")  @map("test_status") // untested | success | failed
  testMessage       String?   @map("test_message")  // Last test error/success message
  lastTestedAt      DateTime? @map("last_tested_at")
  
  // Sync configuration (for hybrid setups)
  enableAutoSync     Boolean   @default(false) @map("enable_auto_sync")  // Auto-sync local ↔ cloud
  syncDirection      String    @default("bidirectional") @map("sync_direction")  // local-to-cloud | cloud-to-local | bidirectional
  lastSyncAt        DateTime? @map("last_sync_at")
  syncStatus        String?   @map("sync_status")  // syncing | success | failed
  
  // Metadata
  createdBy         String    @map("created_by")  // User who created this config
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([isPrimary])
  @@index([type])
  @@map("database_configurations")
}

/**
 * DatabaseSwitchLog — Audit trail of database switches (for compliance).
 * Tracks who switched databases, when, and why.
 */
model DatabaseSwitchLog {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  configId          String   @map("config_id")  // Which config was switched TO
  previousConfigId  String?  @map("previous_config_id")  // Which config was switched FROM
  
  switchedBy        String   @map("switched_by")  // User ID who made the switch
  reason            String?  // Optional: why was the switch made
  
  // Sync details (if data was migrated)
  syncPerformed     Boolean  @default(false) @map("sync_performed")
  recordsMigrated   Int?     @map("records_migrated")
  durationSeconds   Int?     @map("duration_seconds")
  syncStatus        String?  @map("sync_status")  // success | partial | failed
  syncError         String?  @map("sync_error")
  
  createdAt         DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([createdAt])
  @@map("database_switch_logs")
}


// ─── v2.0 Phase B.3.2 — API Gateway & Rate Limiting ────────────────────────────

/**
 * ApiUsage — Tracks API usage per organization and user for rate limiting.
 * Aggregates requests per window (minute/hour/day) for enforcement.
 */
model ApiUsage {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  endpoint       String
  method         String
  requestCount   Int      @default(1) @map("request_count")
  windowStart    DateTime @map("window_start")
  windowEnd      DateTime @map("window_end")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, windowStart])
  @@index([userId, windowStart])
  @@index([windowStart, windowEnd])
  @@map("api_usage")
}

/**
 * RateLimitTier — Defines tiered access plans with different rate limits and features.
 * Tiers: free, starter, professional, enterprise
 */
model RateLimitTier {
  id                   String   @id @default(cuid())
  name                 String   @unique // 'free', 'starter', 'professional', 'enterprise'
  displayName          String   @map("display_name")
  requestsPerDay       Int      @map("requests_per_day")
  requestsPerHour      Int      @map("requests_per_hour")
  requestsPerMinute    Int      @map("requests_per_minute")
  burstLimit           Int      @default(10) @map("burst_limit") // Allow short bursts
  allowedEndpoints     String[] @map("allowed_endpoints") // Empty = all endpoints
  blockedEndpoints     String[] @map("blocked_endpoints")
  maxConnectors        Int?     @map("max_connectors")
  maxUsers             Int?     @map("max_users")
  maxDataExportPerDay  Int?     @map("max_data_export_per_day")
  enableWebhooks       Boolean  @default(false) @map("enable_webhooks")
  enableSso            Boolean  @default(false) @map("enable_sso")
  enableCustomRoles    Boolean  @default(false) @map("enable_custom_roles")
  enableAgents         Boolean  @default(false) @map("enable_agents")
  enableAdvancedBI     Boolean  @default(false) @map("enable_advanced_bi")
  priority             Int      @default(0) // Higher priority = better support
  monthlyPrice         Int      @default(0) @map("monthly_price") // In cents
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")

  organizations OrganizationTier[]

  @@map("rate_limit_tiers")
}

/**
 * OrganizationTier — Associates an organization with a rate limit tier.
 * Supports custom overrides and expiration for trial periods.
 */
model OrganizationTier {
  id             String   @id @default(cuid())
  organizationId String   @unique @map("organization_id")
  tierId         String   @map("tier_id")
  startedAt      DateTime @default(now()) @map("started_at")
  expiresAt      DateTime? @map("expires_at")
  autoRenew      Boolean  @default(true) @map("auto_renew")
  customLimits   Json?    @map("custom_limits") // Override tier defaults
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tier         RateLimitTier @relation(fields: [tierId], references: [id])

  @@index([organizationId])
  @@index([tierId])
  @@map("organization_tiers")
}

/**
 * RateLimitViolation — Logs when an organization exceeds its rate limits.
 * Used for monitoring, alerting, and potential tier upgrade recommendations.
 */
model RateLimitViolation {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  endpoint       String
  method         String
  tierName       String   @map("tier_name")
  limit          Int
  actualCount    Int      @map("actual_count")
  windowType     String   @map("window_type") // 'minute', 'hour', 'day'
  blockedAt      DateTime @default(now()) @map("blocked_at")
  ipAddress      String?  @map("ip_address")
  userAgent      String?  @map("user_agent")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, blockedAt])
  @@index([userId, blockedAt])
  @@map("rate_limit_violations")
}
